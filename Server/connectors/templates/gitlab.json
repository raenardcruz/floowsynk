{
  "id": "gitlab",
  "name": "GitLab",
  "description": "Manage GitLab projects, create issues, trigger CI/CD pipelines, and inspect merge requests.",
  "icon": "/src/components/Icons/gitlab.svg",
  "baseUrl": "https://gitlab.com/api/v4",
  "authType": "oauth2, pat",
  "fields": [
    {
      "key": "client_id",
      "label": "Client ID (Application ID)",
      "type": "text",
      "required": false,
      "placeholder": "Enter GitLab Application ID"
    },
    {
      "key": "client_secret",
      "label": "Client Secret",
      "type": "password",
      "required": false,
      "placeholder": "Enter GitLab Application Secret"
    },
    {
      "key": "access_token",
      "label": "Personal Access Token (PAT)",
      "type": "password",
      "required": false,
      "placeholder": "glpat-..."
    }
  ],
  "oauthConfig": {
    "authorizeUrl": "https://gitlab.com/oauth/authorize",
    "tokenUrl": "https://gitlab.com/oauth/token",
    "defaultScopes": ["api", "read_user"]
  },
  "actions": [
    {
      "id": "list_projects",
      "name": "List Projects",
      "description": "Retrieve projects accessible by the authenticated user",
      "path": "/projects",
      "method": "GET",
      "headers": {
        "Accept": "application/json"
      },
      "queryParams": []
    },
    {
      "id": "get_issues",
      "name": "Get Issues",
      "description": "Retrieve issues for a specific GitLab project",
      "path": "/projects/{{project_id}}/issues",
      "method": "GET",
      "headers": {
        "Accept": "application/json"
      },
      "queryParams": [],
      "fields": [
        { "key": "project_id", "label": "Project ID", "required": true, "placeholder": "Enter GitLab Project ID" }
      ]
    },
    {
      "id": "create_issue",
      "name": "Create Issue",
      "description": "Create a new issue in a GitLab project",
      "path": "/projects/{{project_id}}/issues",
      "method": "POST",
      "headers": {
        "Content-Type": "application/json"
      },
      "queryParams": [],
      "payloadTemplate": "{\"title\": \"{{title}}\", \"description\": \"{{description}}\"}",
      "fields": [
        { "key": "project_id", "label": "Project ID", "required": true, "placeholder": "Enter GitLab Project ID" },
        { "key": "title", "label": "Issue Title", "required": true, "placeholder": "Issue summary" },
        { "key": "description", "label": "Description", "required": false, "placeholder": "Issue body" }
      ]
    },
    {
      "id": "create_merge_request",
      "name": "Create Merge Request",
      "description": "Create a new merge request in a GitLab project",
      "path": "/projects/{{project_id}}/merge_requests",
      "method": "POST",
      "headers": {
        "Content-Type": "application/json"
      },
      "queryParams": [],
      "payloadTemplate": "{\"source_branch\": \"{{source_branch}}\", \"target_branch\": \"{{target_branch}}\", \"title\": \"{{title}}\"}",
      "fields": [
        { "key": "project_id", "label": "Project ID", "required": true, "placeholder": "Enter GitLab Project ID" },
        { "key": "title", "label": "Merge Request Title", "required": true, "placeholder": "MR title" },
        { "key": "source_branch", "label": "Source Branch", "required": true, "placeholder": "feature-branch" },
        { "key": "target_branch", "label": "Target Branch", "required": true, "placeholder": "main" }
      ]
    },
    {
      "id": "trigger_pipeline",
      "name": "Trigger Pipeline",
      "description": "Trigger a CI/CD pipeline run in a GitLab project",
      "path": "/projects/{{project_id}}/pipeline",
      "method": "POST",
      "headers": {
        "Content-Type": "application/json"
      },
      "queryParams": [],
      "payloadTemplate": "{\"token\": \"{{token}}\", \"ref\": \"{{ref}}\"}",
      "fields": [
        { "key": "project_id", "label": "Project ID", "required": true, "placeholder": "Enter GitLab Project ID" },
        { "key": "token", "label": "Trigger Token", "required": true, "placeholder": "Pipeline trigger token" },
        { "key": "ref", "label": "Git Ref / Branch", "required": true, "placeholder": "main" }
      ]
    }
  ]
}
