{
  "id": "slack",
  "name": "Slack",
  "description": "Send notifications and interact with Slack channels.",
  "icon": "/src/components/Icons/slack.svg",
  "baseUrl": "https://slack.com/api",
  "authType": "oauth2",
  "fields": [
    {
      "key": "client_id",
      "label": "Client ID",
      "type": "text",
      "required": false,
      "placeholder": "Enter Slack App Client ID"
    },
    {
      "key": "client_secret",
      "label": "Client Secret",
      "type": "password",
      "required": false,
      "placeholder": "Enter Slack App Client Secret"
    },
    {
      "key": "access_token",
      "label": "Bot User OAuth Token",
      "type": "password",
      "required": false,
      "placeholder": "xoxb-..."
    }
  ],
  "oauthConfig": {
    "authorizeUrl": "https://slack.com/oauth/v2/authorize",
    "tokenUrl": "https://slack.com/api/oauth.v2.access",
    "defaultScopes": [
      "chat:write",
      "chat:write.public",
      "channels:read",
      "users:read"
    ]
  },
  "actions": [
    {
      "id": "post_message",
      "name": "Post Message",
      "description": "Send a message to a Slack channel",
      "path": "/chat.postMessage",
      "method": "POST",
      "headers": {
        "Content-Type": "application/json; charset=utf-8"
      },
      "queryParams": [],
      "payloadTemplate": "{\"channel\": \"{{channel}}\", \"text\": \"{{message}}\"}",
      "fields": [
        {
          "key": "channel",
          "label": "Channel ID / Name",
          "required": true,
          "placeholder": "#general or C123456"
        },
        {
          "key": "message",
          "label": "Message Text",
          "required": true,
          "placeholder": "Hello from FloowSynk!"
        }
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "description": "Slack Channel ID or Name",
            "example": "#general or C12345678"
          },
          "message": {
            "type": "string",
            "description": "Message Text",
            "example": "Hello team! Weekly sync starts in 10 minutes."
          }
        },
        "required": [
          "channel",
          "message"
        ]
      },
      "outputSchema": {
        "ok": true,
        "channel": "C12345678",
        "ts": "1723026000.000200"
      }
    },
    {
      "id": "list_channels",
      "name": "List Channels",
      "description": "Retrieve list of channels in the Slack workspace",
      "path": "/conversations.list",
      "method": "GET",
      "headers": {
        "Accept": "application/json"
      },
      "queryParams": [
        "types"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "types": {
            "type": "string",
            "description": "Channel types to list (public_channel, private_channel)",
            "default": "public_channel"
          }
        }
      },
      "outputSchema": [
        {
          "id": "C12345678",
          "name": "general"
        }
      ]
    },
    {
      "id": "get_user_info",
      "name": "Get User Info",
      "description": "Retrieve profile information for a Slack user",
      "path": "/users.info",
      "method": "GET",
      "headers": {
        "Accept": "application/json"
      },
      "queryParams": [
        "user"
      ],
      "fields": [
        {
          "key": "user",
          "label": "User ID",
          "required": true,
          "placeholder": "U12345678"
        }
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "user": {
            "type": "string",
            "description": "Slack User ID",
            "example": "U12345678"
          }
        },
        "required": [
          "user"
        ]
      },
      "outputSchema": {
        "id": "U12345678",
        "name": "janesmith"
      }
    }
  ]
}