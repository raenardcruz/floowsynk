{
  "id": "jira",
  "name": "Jira",
  "description": "Create Jira issues, update issue statuses, search projects, and track software bugs.",
  "icon": "/src/components/Icons/jira.svg",
  "baseUrl": "https://api.atlassian.com/ex/jira/{{cloud_id}}/rest/api/3",
  "authType": "oauth2",
  "fields": [
    {
      "key": "client_id",
      "label": "Client ID",
      "type": "text",
      "required": false,
      "placeholder": "Enter Atlassian OAuth Client ID"
    },
    {
      "key": "client_secret",
      "label": "Client Secret",
      "type": "password",
      "required": false,
      "placeholder": "Enter Atlassian OAuth Client Secret"
    },
    {
      "key": "access_token",
      "label": "API Token",
      "type": "password",
      "required": false,
      "placeholder": "Enter Atlassian API Token"
    }
  ],
  "oauthConfig": {
    "authorizeUrl": "https://auth.atlassian.com/authorize",
    "tokenUrl": "https://auth.atlassian.com/oauth/token",
    "defaultScopes": [
      "read:jira-work",
      "write:jira-work"
    ]
  },
  "actions": [
    {
      "id": "search_issues",
      "name": "Search Issues (JQL)",
      "description": "Search issues using Jira Query Language (JQL)",
      "path": "/search",
      "method": "POST",
      "headers": {
        "Content-Type": "application/json",
        "Accept": "application/json"
      },
      "queryParams": [],
      "payloadTemplate": "{\"jql\": \"{{jql}}\"}",
      "fields": [
        {
          "key": "jql",
          "label": "JQL Query",
          "required": true,
          "placeholder": "project = PROJ AND status = Open"
        }
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "jql": {
            "type": "string",
            "description": "JQL query string",
            "example": "project = PROJ"
          }
        },
        "required": [
          "jql"
        ]
      },
      "outputSchema": {
        "issues": [
          {
            "id": "10000",
            "key": "PROJ-123",
            "fields": {
              "summary": "API 500 Error"
            }
          }
        ]
      }
    },
    {
      "id": "create_issue",
      "name": "Create Issue",
      "description": "Create a new issue in a Jira project",
      "path": "/issue",
      "method": "POST",
      "headers": {
        "Content-Type": "application/json",
        "Accept": "application/json"
      },
      "queryParams": [],
      "payloadTemplate": "{\"fields\": {\"project\": {\"key\": \"{{project_key}}\"}, \"summary\": \"{{summary}}\", \"description\": \"{{description}}\", \"issuetype\": {\"name\": \"{{issue_type}}\"}}}",
      "fields": [
        {
          "key": "project_key",
          "label": "Project Key",
          "required": true,
          "placeholder": "e.g. PROJ"
        },
        {
          "key": "summary",
          "label": "Issue Summary",
          "required": true,
          "placeholder": "Enter issue summary"
        },
        {
          "key": "description",
          "label": "Description",
          "required": false,
          "placeholder": "Issue description"
        },
        {
          "key": "issue_type",
          "label": "Issue Type",
          "required": false,
          "placeholder": "Task"
        }
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectKey": {
            "type": "string",
            "description": "Jira Project Key",
            "example": "PROJ"
          },
          "summary": {
            "type": "string",
            "description": "Issue summary / title",
            "example": "API Endpoint returns 500 error"
          },
          "description": {
            "type": "string",
            "description": "Issue detailed description",
            "example": "Occurs when calling POST /api/data."
          },
          "issueType": {
            "type": "string",
            "description": "Issue Type Name",
            "default": "Task"
          }
        },
        "required": [
          "projectKey",
          "summary"
        ]
      },
      "outputSchema": {
        "id": "10000",
        "key": "PROJ-123",
        "self": "https://your-domain.atlassian.net/rest/api/3/issue/10000"
      }
    },
    {
      "id": "get_issue",
      "name": "Get Issue Details",
      "description": "Retrieve detailed information for a specific Jira issue",
      "path": "/issue/{{issue_key}}",
      "method": "GET",
      "headers": {
        "Accept": "application/json"
      },
      "queryParams": [],
      "fields": [
        {
          "key": "issue_key",
          "label": "Issue Key",
          "required": true,
          "placeholder": "PROJ-123"
        }
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "issue_id": {
            "type": "string",
            "description": "Issue Key or ID",
            "example": "PROJ-123"
          }
        },
        "required": [
          "issue_id"
        ]
      },
      "outputSchema": {
        "id": "10000",
        "key": "PROJ-123",
        "self": "https://your-domain.atlassian.net/rest/api/3/issue/10000"
      }
    },
    {
      "id": "update_issue",
      "name": "Update Issue",
      "description": "Update details or fields of a Jira issue",
      "path": "/issue/{{issue_key}}",
      "method": "PUT",
      "headers": {
        "Content-Type": "application/json",
        "Accept": "application/json"
      },
      "queryParams": [],
      "payloadTemplate": "{\"fields\": {{fields}} }",
      "fields": [
        {
          "key": "issue_key",
          "label": "Issue Key",
          "required": true,
          "placeholder": "PROJ-123"
        },
        {
          "key": "fields",
          "label": "Fields (JSON)",
          "required": true,
          "placeholder": "{\"summary\": \"Updated summary\"}"
        }
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "issue_id": {
            "type": "string",
            "description": "Issue Key or ID",
            "example": "PROJ-123"
          },
          "summary": {
            "type": "string",
            "description": "Updated Summary",
            "example": "API 500 Error resolved"
          }
        },
        "required": [
          "issue_id"
        ]
      },
      "outputSchema": {
        "id": "10000",
        "key": "PROJ-123",
        "status": "updated"
      }
    }
  ]
}