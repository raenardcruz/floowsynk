{
  "id": "notion",
  "name": "Notion",
  "description": "Create database items, append page content, and query Notion workspaces.",
  "icon": "/src/components/Icons/notion.svg",
  "baseUrl": "https://api.notion.com/v1",
  "authType": "oauth2, apikey",
  "fields": [
    {
      "key": "access_token",
      "label": "Internal Integration Secret",
      "type": "password",
      "required": true,
      "placeholder": "secret_... or ntn_..."
    }
  ],
  "oauthConfig": {
    "authorizeUrl": "https://api.notion.com/v1/oauth/authorize",
    "tokenUrl": "https://api.notion.com/v1/oauth/token",
    "defaultScopes": []
  },
  "actions": [
    {
      "id": "query_database",
      "name": "Query Database",
      "description": "Query items from a Notion database",
      "path": "/databases/{{database_id}}/query",
      "method": "POST",
      "headers": {
        "Content-Type": "application/json",
        "Notion-Version": "2022-06-28"
      },
      "queryParams": [],
      "payloadTemplate": "{}",
      "fields": [
        {
          "key": "database_id",
          "label": "Database ID",
          "required": true,
          "placeholder": "Enter Notion Database ID"
        }
      ]
    },
    {
      "id": "create_page",
      "name": "Create Page",
      "description": "Create a new page or item in a Notion database",
      "path": "/pages",
      "method": "POST",
      "headers": {
        "Content-Type": "application/json",
        "Notion-Version": "2022-06-28"
      },
      "queryParams": [],
      "payloadTemplate": "{\"parent\": {\"database_id\": \"{{database_id}}\"}, \"properties\": {{properties}}}",
      "fields": [
        {
          "key": "database_id",
          "label": "Database ID",
          "required": true,
          "placeholder": "Enter Notion Database ID"
        },
        {
          "key": "properties",
          "label": "Properties (JSON)",
          "required": true,
          "placeholder": "{\"Name\": {\"title\": [{\"text\": {\"content\": \"New Page\"}}]}}"
        }
      ]
    },
    {
      "id": "retrieve_page",
      "name": "Retrieve Page",
      "description": "Retrieve detailed information for a specific page",
      "path": "/pages/{{page_id}}",
      "method": "GET",
      "headers": {
        "Notion-Version": "2022-06-28"
      },
      "queryParams": [],
      "fields": [
        {
          "key": "page_id",
          "label": "Page ID",
          "required": true,
          "placeholder": "Enter Notion Page ID (e.g. 32-char UUID)"
        }
      ]
    },
    {
      "id": "update_page",
      "name": "Update Page Properties",
      "description": "Update page properties in Notion",
      "path": "/pages/{{page_id}}",
      "method": "PATCH",
      "headers": {
        "Content-Type": "application/json",
        "Notion-Version": "2022-06-28"
      },
      "queryParams": [],
      "payloadTemplate": "{\"properties\": {{properties}} }",
      "fields": [
        {
          "key": "page_id",
          "label": "Page ID",
          "required": true,
          "placeholder": "Enter Notion Page ID"
        },
        {
          "key": "properties",
          "label": "Properties (JSON)",
          "required": true,
          "placeholder": "{\"Title\": {\"title\": [{\"text\": {\"content\": \"Updated Title\"}}]}}"
        }
      ]
    }
  ]
}
