{
  "id": "resend",
  "name": "Resend",
  "category": "Communication & Email",
  "description": "Modern developer-first transactional email API to send beautiful emails with high deliverability.",
  "icon": "/src/components/Icons/resend.svg",
  "baseUrl": "https://api.resend.com",
  "authType": "apikey",
  "fields": [
    {
      "key": "api_key",
      "label": "Resend API Key",
      "type": "password",
      "required": true,
      "placeholder": "re_..."
    }
  ],
  "actions": [
    {
      "id": "send_email",
      "name": "Send Email",
      "description": "Send a transactional email with HTML or text content",
      "path": "/emails",
      "method": "POST",
      "headers": {
        "Authorization": "Bearer {{api_key}}",
        "Content-Type": "application/json"
      },
      "queryParams": [],
      "payloadTemplate": "{\"from\": \"{{from}}\", \"to\": [\"{{to}}\"], \"subject\": \"{{subject}}\", \"html\": \"{{html}}\"}",
      "fields": [
        { "key": "from", "label": "From Email", "type": "text", "required": true, "placeholder": "onboarding@resend.dev or verified domain" },
        { "key": "to", "label": "To Email", "type": "text", "required": true, "placeholder": "user@example.com" },
        { "key": "subject", "label": "Subject Line", "type": "text", "required": true, "placeholder": "Welcome to FlowSynk!" },
        { "key": "html", "label": "HTML / Body", "type": "text", "required": true, "placeholder": "<p>Thanks for signing up!</p>" }
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "from": { "type": "string", "description": "Sender email address" },
          "to": { "type": "string", "description": "Recipient email address" },
          "subject": { "type": "string", "description": "Email subject" },
          "html": { "type": "string", "description": "Email HTML content" }
        },
        "required": ["from", "to", "subject", "html"]
      },
      "outputSchema": {
        "id": "49a3999c-0ce1-4ea6-ab68-afcd6dc2e794",
        "from": "onboarding@resend.dev",
        "to": ["user@example.com"],
        "created_at": "2026-01-01T00:00:00Z"
      }
    },
    {
      "id": "get_email",
      "name": "Get Email Status",
      "description": "Retrieve delivery status and event logs for a sent email",
      "path": "/emails/{{email_id}}",
      "method": "GET",
      "headers": {
        "Authorization": "Bearer {{api_key}}"
      },
      "queryParams": [],
      "payloadTemplate": "",
      "fields": [
        { "key": "email_id", "label": "Email ID", "type": "text", "required": true, "placeholder": "e.g. 49a3999c-0ce1-..." }
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "email_id": { "type": "string", "description": "Resend Email UUID" }
        },
        "required": ["email_id"]
      },
      "outputSchema": {
        "id": "49a3999c-0ce1-4ea6-ab68-afcd6dc2e794",
        "to": ["user@example.com"],
        "last_event": "delivered"
      }
    }
  ]
}
