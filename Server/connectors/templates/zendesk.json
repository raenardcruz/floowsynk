{
  "id": "zendesk",
  "name": "Zendesk",
  "description": "Manage tickets, users, and organization data in Zendesk Support.",
  "icon": "/src/components/Icons/zendesk.svg",
  "baseUrl": "https://{{subdomain}}.zendesk.com/api/v2",
  "authType": "basic, apikey, oauth2",
  "fields": [
    {
      "key": "subdomain",
      "label": "Subdomain",
      "type": "text",
      "required": true,
      "placeholder": "yoursubdomain"
    },
    {
      "key": "email",
      "label": "Email Address",
      "type": "text",
      "required": true,
      "placeholder": "admin@company.com/token"
    },
    {
      "key": "api_token",
      "label": "API Token",
      "type": "password",
      "required": true,
      "placeholder": "Enter Zendesk API Token"
    }
  ],
  "oauthConfig": {
    "authorizeUrl": "https://{{subdomain}}.zendesk.com/oauth/authorizations/new",
    "tokenUrl": "https://{{subdomain}}.zendesk.com/oauth/tokens",
    "defaultScopes": ["read", "write"]
  },
  "actions": [
    {
      "id": "list_tickets",
      "name": "List Tickets",
      "description": "Retrieve tickets from Zendesk Support",
      "path": "/tickets.json",
      "method": "GET",
      "headers": {
        "Content-Type": "application/json"
      },
      "queryParams": [],
      "fields": [],
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "tickets": [
          {
            "id": 1,
            "subject": "Sample ticket",
            "status": "open",
            "priority": "normal",
            "created_at": "2026-08-05T12:00:00Z"
          }
        ]
      }
    },
    {
      "id": "create_ticket",
      "name": "Create Ticket",
      "description": "Create a new ticket in Zendesk",
      "path": "/tickets.json",
      "method": "POST",
      "headers": {
        "Content-Type": "application/json"
      },
      "payloadTemplate": "{\"ticket\": {\"subject\": \"{{subject}}\", \"comment\": {\"body\": \"{{comment_body}}\"}, \"priority\": \"{{priority}}\", \"type\": \"{{type}}\"}}",
      "fields": [
        { "key": "subject", "label": "Subject", "required": true, "placeholder": "Enter ticket subject" },
        { "key": "comment_body", "label": "Comment Body", "required": true, "placeholder": "Enter initial ticket comment" },
        { "key": "priority", "label": "Priority", "required": false, "placeholder": "urgent, high, normal, or low" },
        { "key": "type", "label": "Type", "required": false, "placeholder": "problem, incident, question, task" }
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "subject": { "type": "string", "description": "Ticket subject", "example": "Help with login" },
          "comment_body": { "type": "string", "description": "Initial ticket comment/description", "example": "Unable to reset password" },
          "priority": { "type": "string", "description": "Ticket priority", "example": "high" },
          "type": { "type": "string", "description": "Ticket type", "example": "incident" }
        },
        "required": ["subject", "comment_body"]
      },
      "outputSchema": {
        "ticket": {
          "id": 100,
          "subject": "Help with login",
          "status": "new",
          "priority": "high",
          "created_at": "2026-08-07T12:00:00Z"
        }
      }
    },
    {
      "id": "update_ticket",
      "name": "Update Ticket",
      "description": "Update an existing Zendesk ticket",
      "path": "/tickets/{{ticket_id}}.json",
      "method": "PUT",
      "headers": {
        "Content-Type": "application/json"
      },
      "payloadTemplate": "{\"ticket\": {\"status\": \"{{status}}\", \"comment\": {\"body\": \"{{comment_body}}\"}}}",
      "fields": [
        { "key": "ticket_id", "label": "Ticket ID", "required": true, "placeholder": "100" },
        { "key": "status", "label": "Status", "required": false, "placeholder": "open, pending, solved, closed" },
        { "key": "comment_body", "label": "Comment Body", "required": false, "placeholder": "Add a reply comment" }
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "ticket_id": { "type": "string", "description": "ID of ticket to update", "example": "100" },
          "status": { "type": "string", "description": "Updated status", "example": "solved" },
          "comment_body": { "type": "string", "description": "Comment text", "example": "Issue has been resolved." }
        },
        "required": ["ticket_id"]
      },
      "outputSchema": {
        "ticket": {
          "id": 100,
          "status": "solved",
          "updated_at": "2026-08-07T12:05:00Z"
        }
      }
    },
    {
      "id": "list_users",
      "name": "List Users",
      "description": "Retrieve users registered in Zendesk",
      "path": "/users.json",
      "method": "GET",
      "headers": {
        "Content-Type": "application/json"
      },
      "queryParams": [],
      "fields": [],
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "users": [
          {
            "id": 1,
            "name": "John Doe",
            "email": "john@company.com",
            "role": "end-user"
          }
        ]
      }
    }
  ]
}
