{
  "id": "aws_s3",
  "name": "AWS S3",
  "description": "Store and retrieve files and objects in Amazon S3 buckets.",
  "icon": "/src/components/Icons/aws_s3.svg",
  "baseUrl": "https://{{bucket_name}}.s3.{{region}}.amazonaws.com",
  "authType": "custom",
  "fields": [
    {
      "key": "access_key_id",
      "label": "Access Key ID",
      "type": "text",
      "required": true,
      "placeholder": "AKIA..."
    },
    {
      "key": "secret_access_key",
      "label": "Secret Access Key",
      "type": "password",
      "required": true,
      "placeholder": "Enter secret access key"
    },
    {
      "key": "region",
      "label": "Region",
      "type": "text",
      "required": true,
      "placeholder": "us-east-1"
    },
    {
      "key": "bucket_name",
      "label": "Bucket Name",
      "type": "text",
      "required": true,
      "placeholder": "my-s3-bucket"
    }
  ],
  "actions": [
    {
      "id": "upload_file",
      "name": "Upload File",
      "description": "Upload an object to S3 bucket",
      "path": "/{{object_key}}",
      "method": "PUT",
      "headers": {
        "Content-Type": "{{content_type}}"
      },
      "queryParams": [],
      "payloadTemplate": "{{content}}",
      "fields": [
        { "key": "object_key", "label": "S3 Object Key / Path", "required": true, "placeholder": "path/to/file.txt" },
        { "key": "content", "label": "File Content", "required": true, "placeholder": "Enter object file content" },
        { "key": "content_type", "label": "Content Type", "required": false, "placeholder": "text/plain" }
      ]
    },
    {
      "id": "download_file",
      "name": "Download File",
      "description": "Retrieve an object from S3 bucket",
      "path": "/{{object_key}}",
      "method": "GET",
      "headers": {},
      "queryParams": [],
      "payloadTemplate": "",
      "fields": [
        { "key": "object_key", "label": "S3 Object Key / Path", "required": true, "placeholder": "path/to/file.txt" }
      ]
    },
    {
      "id": "delete_file",
      "name": "Delete File",
      "description": "Delete an object from S3 bucket",
      "path": "/{{object_key}}",
      "method": "DELETE",
      "headers": {},
      "queryParams": [],
      "payloadTemplate": "",
      "fields": [
        { "key": "object_key", "label": "S3 Object Key / Path", "required": true, "placeholder": "path/to/file.txt" }
      ]
    },
    {
      "id": "list_objects",
      "name": "List Objects",
      "description": "List objects in S3 bucket",
      "path": "/",
      "method": "GET",
      "headers": {},
      "queryParams": [
        { "key": "list-type", "value": "2" }
      ],
      "payloadTemplate": ""
    }
  ]
}
